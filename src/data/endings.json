{
  "endings": [
    {
      "id": "ending_full_zombie",
      "title": { "zh": "你已经不再是你了" },
      "type": "bad",
      "priority": 1,
      "conditions": {
        "requiredStats": [{ "stat": "infection", "min": 10 }]
      },
      "narrative": [
        { "zh": "不是某一刻发生的。" },
        { "zh": "是一系列你都觉得合理的选择，一步一步，把你带到了这里。" },
        { "zh": "最后一个清醒的念头，是工具箱底层那份折过两次的报纸。" },
        { "zh": "然后，什么都没有了。" }
      ],
      "epilogue": null
    },
    {
      "id": "ending_cold_death",
      "title": { "zh": "极寒中的无声熄火" },
      "type": "bad",
      "priority": 1.5,
      "conditions": {
        "requiredStats": [{ "stat": "health", "max": 0 }],
        "blockedFlags": ["winter_shelter_established", "base_bunker"]
      },
      "narrative": [
        { "zh": "不是某一刻决定的。" },
        { "zh": "只是体温又低了一点，然后又低了一点，低到你觉得暖和了——那是最后一步。" },
        { "zh": "工具箱还在桌上，干干净净的。" }
      ],
      "epilogue": null
    },
    {
      "id": "ending_death_health",
      "title": { "zh": "这座城市带走了你" },
      "type": "bad",
      "priority": 2,
      "conditions": {
        "requiredStats": [{ "stat": "health", "max": 0 }]
      },
      "narrative": [
        { "zh": "你的身体撑不住了。这座你试图在其中活下去的城市，已经不再需要你了。" },
        { "zh": "但在某个地方，一个陌生人还记得你的名字。" }
      ],
      "epilogue": null
    },
    {
      "id": "ending_death_morale",
      "title": { "zh": "无声的崩塌" },
      "type": "bad",
      "priority": 3,
      "conditions": {
        "requiredStats": [{ "stat": "morale", "max": 0 }]
      },
      "narrative": [
        { "zh": "最终击垮你的，不是那些死者。" },
        { "zh": "你只是停下来了。坐了下去。" },
        { "zh": "没有再站起来。" }
      ],
      "epilogue": null
    },
    {
      "id": "ending_fortress_irony",
      "title": { "zh": "自缚的钢铁巨兽" },
      "type": "bad",
      "priority": 5,
      "conditions": {
        "requiredFlags": ["survived_one_year", "zombie_turning"],
        "securityMin": 80
      },
      "narrative": [
        {
          "zh": "你修好了电焊机。你加固了大门。你把三张铁板用铁丝绞死在门板内侧，把铁链横穿底部绕过承重柱，整扇门变成了一面冷冰冰的钢板。"
        },
        { "zh": "你做到了。安全指数一百。没有任何东西能从外面进来。" },
        { "zh": "讽刺的是——也没有任何东西，能从里面出去。" },
        { "zh": "当你彻底失去理智的那一天，你把自己死死关在了这间六楼的无敌铁皮屋里。" },
        { "zh": "精密的工程，完美的囚笼。" }
      ],
      "epilogue": { "zh": "那台修好的电焊机一直立在矮桌上，安静，完好，没有人再用它了。" }
    },
    {
      "id": "ending_fortress_solo",
      "title": { "zh": "最强钉子户" },
      "type": "neutral",
      "priority": 6,
      "conditions": {
        "requiredFlags": ["survived_one_year", "base_factory"],
        "blockedFlags": ["has_group", "zombie_turning"],
        "requiredStats": [
          { "stat": "infection", "max": 2 },
          { "stat": "health", "min": 1 }
        ],
        "securityMin": 80
      },
      "narrative": [
        { "zh": "你用一年的时间把这栋楼六层的一个单元变成了任何东西都攻不进来的地方。" },
        { "zh": "防御指数八十。工厂那边弄来的材料已经用完了，但比你最初计划的还多撑了三个月。" },
        { "zh": "还剩三罐食物。比你最乐观的估算多一罐。" },
        { "zh": "你在门板的计数格旁边写下了「365」，然后在旁边划了一个小圆圈。表示完成。" }
      ],
      "epilogue": { "zh": "外面的声音小了很多。不知道是因为它们走远了，还是因为你已经习惯了。" }
    },
    {
      "id": "ending_solo_survivor",
      "title": { "zh": "废墟中独行" },
      "type": "neutral",
      "priority": 10,
      "conditions": {
        "requiredFlags": ["survived_one_year"],
        "blockedFlags": ["has_group"],
        "requiredStats": [{ "stat": "health", "min": 1 }]
      },
      "narrative": [
        { "zh": "你活下来了。一个人。" },
        { "zh": "这座城市现在更安静了——不是平静，只是空旷。" },
        { "zh": "你不再数日子。这已经不像是活着了。" }
      ],
      "epilogue": { "zh": "又过了三个月，你捕捉到一段来自海岸的无线电信号。" }
    },
    {
      "id": "ending_escape_truck",
      "title": { "zh": "钥匙与公路" },
      "type": "neutral",
      "priority": 12,
      "conditions": {
        "requiredFlags": ["survived_one_year", "truck_key_found"],
        "requiredItems": [{ "itemId": "truck_key" }]
      },
      "narrative": [
        { "zh": "你在裤兜里摸到了那串钥匙。陈师傅的卡车。楼下停着，一直没人动。" },
        { "zh": "发动机头几秒没有响应，然后——嗡，平稳的电流声。" },
        { "zh": "你挂上挡，把城市甩在了后视镜里。" },
        { "zh": "不知道要去哪。但总比困在这里强。" }
      ],
      "epilogue": {
        "zh": "高速公路上有几辆废弃的轿车，你绕着开过去了。前方二百公里，一个路标还立着：「南城 ↑」。"
      }
    },
    {
      "id": "ending_superpower_awakening",
      "title": { "zh": "新人类先驱" },
      "type": "good",
      "priority": 15,
      "conditions": {
        "requiredFlags": ["survived_one_year", "superpower_awakening"],
        "requiredStats": [
          { "stat": "will", "min": 8 },
          { "stat": "infection", "min": 3 },
          { "stat": "infection", "max": 7 }
        ]
      },
      "narrative": [
        { "zh": "你摸了一下大门上的铁板。" },
        {
          "zh": "你感觉到了它的内部——铁丝绞合的应力，螺纹咬合的摩擦，整扇门的重量分布，清晰得像是在看一张蓝图。"
        },
        {
          "zh": "三层楼以下，有什么东西在移动。你听见了它的心跳，不是人的节奏，但足够让你分辨方向。"
        },
        { "zh": "病毒没有把你变成它们。它把你变成了别的什么。" }
      ],
      "epilogue": { "zh": "你不知道世界上还有多少个像你这样的人。但你开始觉得，这值得去找。" }
    },
    {
      "id": "ending_community_leader",
      "title": { "zh": "最后的城市" },
      "type": "good",
      "priority": 20,
      "conditions": {
        "requiredFlags": ["survived_one_year", "has_group", "built_shelter"],
        "requiredStats": [
          { "stat": "leadership", "min": 15 },
          { "stat": "trust", "min": 12 }
        ]
      },
      "narrative": [
        { "zh": "你没有只是活下来。你建造了一些东西。" },
        { "zh": "四十三个人叫这里家。他们为口粮争吵，为值守班次拌嘴，为谁住角落那间房计较。" },
        { "zh": "普通的问题。人的问题。你从没想到自己会为这些事感到庆幸。" }
      ],
      "epilogue": { "zh": "三年后，另一个定居点发来无线电信号。他们已经听说了你的名字。" }
    },
    {
      "id": "ending_the_record",
      "title": { "zh": "记录者" },
      "type": "secret",
      "priority": 25,
      "conditions": {
        "requiredFlags": ["survived_one_year", "wrote_journal"],
        "requiredStats": [{ "stat": "will", "min": 7 }]
      },
      "narrative": [
        {
          "zh": "你的笔记本里有三百六十五天的记录。时间线，死亡人数，气温变化，门外的声音，裴嘉应最后说的那句话。"
        },
        { "zh": "你不确定有没有人会读它。" },
        { "zh": "但你写下去了。因为有人必须。" }
      ],
      "epilogue": { "zh": "十年后，一个孩子在废弃图书馆的书架后面找到了它。" }
    }
  ]
}
