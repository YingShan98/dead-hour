{
  "id": "scene_102",
  "title": { "zh": "胶带与伤口" },
  "act": "act1",
  "gameTime": { "hoursFromStart": -47 },
  "conditionalNarrative": [
    {
      "conditions": { "requiredFlags": ["researched_outbreak_early"] },
      "zh": "裴嘉应昨晚在电话里压低声音说的话还在。你试着不去想「咬伤」两个字，但手边的焊机提醒着你——你今天也划伤了，在废品站，被一台来路不明的旧机器。"
    },
    {
      "conditions": {
        "requiredFlags": ["noticed_outbreak_signs"],
        "blockedFlags": ["researched_outbreak_early"]
      },
      "zh": "11天，7天，4天。间隔还在缩短。你坐在桌前，没有动工具箱。"
    }
  ],
  "narrative": [
    { "zh": "睡前你低头看了一眼右手中指。胶带边缘翘起来一点，底下有一小块暗红色的干血。" },
    { "zh": "划开的时候不疼，现在也不疼。只是有点痒，像皮下有什么在慢慢结痂。" },
    {
      "zh": "但这台电焊机来自废品站。机身侧面有一张褪色的工厂标签，印着一串八位批次编号，制造商一栏是空的。翻新之前是什么样的废铁，在那里待了多久，原来的主人是谁——你都不知道，也没有再想。"
    }
  ],
  "conditions": {
    "requiredFlags": ["finger_cut"]
  },
  "choices": [
    {
      "id": "scene_102_choice_a",
      "text": { "zh": "先睡觉。小伤口，不碍事，明天买创可贴换上。" },
      "conditions": {},
      "effects": {
        "flags": { "wound_ignored": true },
        "stats": { "infection": 1, "health": 1 },
        "timeCost": 0
      },
      "consequence": [
        { "zh": "你摁了摁胶带，关了灯，躺下来。" },
        { "zh": "你没有注意到，电焊机生锈铁皮上沾着的某些东西，已经顺着血液，悄悄流向了你的掌心。" }
      ],
      "nextSceneId": "scene_103"
    },
    {
      "id": "scene_102_choice_b",
      "text": { "zh": "用急救箱里的碘伏把伤口重新处理一遍，缠上干净纱布。" },
      "conditions": {
        "requiredItems": [{ "itemId": "medkit", "minQuantity": 1 }]
      },
      "hint": { "zh": "急救箱" },
      "effects": {
        "flags": { "wound_cleaned": true },
        "stats": { "infection": -1, "will": 1 },
        "items": [{ "itemId": "medkit", "delta": -1 }],
        "timeCost": 1
      },
      "consequence": [
        { "zh": "你强迫自己冷静下来，放下扳手，去翻急救箱。" },
        {
          "zh": "碘伏冲洗伤口的灼烧感让你浑身冒汗。你逼着自己多冲了两遍，直到切口变成干净的粉红色。"
        },
        { "zh": "耽误了将近一个小时。但伤口是干净的了。" }
      ],
      "nextSceneId": "scene_103"
    },
    {
      "id": "scene_102_choice_c",
      "text": { "zh": "凑近了仔细看——颜色确实不太对。用清水反复冲了好几遍，换上干净胶带。" },
      "conditions": {},
      "effects": {
        "flags": {
          "wound_cleaned": true,
          "noticed_wound_color": true
        },
        "stats": { "infection": -1, "will": 2, "morale": -1 },
        "timeCost": 1
      },
      "consequence": [
        { "zh": "伤口边缘的颜色不太对——不是正常愈合的那种粉红，而是一种偏暗的、有点发青的色调。" },
        { "zh": "你把它冲了很久。躺下来，一直睡不着。" }
      ],
      "nextSceneId": "scene_103"
    }
  ]
}
