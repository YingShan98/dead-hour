{
  "id": "scene_109_awakening",
  "title": { "zh": "天亮·其一" },
  "act": "act2",
  "gameTime": { "hoursFromStart": 8 },
  "conditionalNarrative": [
    {
      "conditions": { "requiredFlags": ["wrote_journal"] },
      "zh": "备忘录里昨晚那几行字还在。你对比了一下手背的颜色——没有更好，也没有更坏。"
    },
    {
      "conditions": { "requiredFlags": ["superpower_awakening"] },
      "zh": "你在门口坐了一夜。灰蓝色的光进来的时候，你发现自己的听觉还停在昨夜——楼上有人翻身，三楼，清晰得像在耳边。"
    },
    {
      "conditions": { "blockedFlags": ["superpower_awakening", "wrote_journal"] },
      "zh": "你站起来，在光和平坦的屋子里站了一会儿，耳朵捕捉到楼下极轻的动静——有人翻身，一楼，清晰得不像平时。你以前从来听不到的。"
    }
  ],
  "narrative": [
    { "zh": "天光从窗帘边缘透进来，灰白色，好像这座城市还有一次正常的早晨。" },
    {
      "zh": "你怔了一会儿。右手中指，那道胶带底下，皮肤泛滑，没有红透，没有渗液。愈合的速度比你预期的快了很多。"
    },
    { "zh": "你盯着自己的手看了一会儿。" },
    { "zh": "门外的世界在继续，但不是昨天那个了。" }
  ],
  "conditions": {
    "blockedFlags": ["zombie_turning"]
  },
  "choices": [
    {
      "id": "scene_109_awakening_choice_a",
      "text": { "zh": "这是幻觉，或者是高度紧绷之后的某种放大。记下来，继续观察。" },
      "conditions": {},
      "effects": {
        "flags": { "wrote_journal": true },
        "stats": { "will": 2, "infection": -1 },
        "items": []
      },
      "consequence": [
        { "zh": "你在备忘录里又加了两条：愈合速度，听觉。" },
        { "zh": "写完之后，你合上手机。记录不能代替结论，但能防止你骗自己。" }
      ],
      "nextSceneId": "scene_110"
    },
    {
      "id": "scene_109_awakening_choice_b",
      "text": { "zh": "试了一下——握紧拳头，集中想着楼道里的动静。和昨天不一样。" },
      "conditions": {
        "requiredFlags": ["superpower_awakening"]
      },
      "hint": { "zh": "需要：已触发觉醒" },
      "effects": {
        "flags": { "superpower_awakening": true },
        "stats": { "health": 1, "stealth": 1, "will": 1, "infection": 1 },
        "items": []
      },
      "consequence": [
        { "zh": "你闭眼，集中精神。楼道里的拖拽声——不是现在，是记忆——在脑子里标出方向和距离。" },
        { "zh": "睁开眼时，你不确定这是能力还是幻觉。但标还在。" }
      ],
      "nextSceneId": "scene_110"
    },
    {
      "id": "scene_109_awakening_choice_c",
      "text": { "zh": "吃点东西。现在需要的是储能，不是结论。" },
      "conditions": {},
      "effects": {
        "stats": { "health": 2, "morale": 1 },
        "items": [{ "itemId": "canned_food", "delta": -1 }]
      },
      "consequence": [
        { "zh": "你打开一罐吃的，慢慢嚼完。" },
        { "zh": "胃满了，脑子才慢慢跟上。今天还有一整扇门要守。" }
      ],
      "nextSceneId": "scene_110"
    }
  ]
}
